n        ,\\\\n        CAST(avg(CAST(t_a_0.`考试分数` AS DECIMAL(20,0))) AS DECIMAL(20,2)) AS f_ay_0,\\\\n        max(CAST(t_a_0.`考试分数副本1` AS DECIMAL(20,0))) AS f_ay_1,\\\\n        min(CAST(t_a_0.`考试分数副本2` AS DECIMAL(20,0))) AS f_ay_2,\\\\n        sum(CAST(t_a_0.`是否60分以下` AS DECIMAL(20,0))) AS f_ay_3\\\\n    FROM\\\\n        (SELECT\\\\n        \\\\tt2.EXAM_KIND_NAME 考试类型,\\\\n        \\\\tt1.mes_Score 考试分数,\\\\n        \\\\tt1.mes_Score 考试分数副本1,\\\\n        \\\\tt1.mes_Score 考试分数副本2,\\\\n        \\\\tt1.mes_sub_name 科目,\\\\n        CASE\\\\n        \\\\t\\\\tWHEN t3.cla_Name LIKE '%高一%' THEN\\\\n        \\\\t\\\\t'高一' \\\\n        \\\\t\\\\tWHEN t3.cla_Name LIKE '%高二%' THEN\\\\n        \\\\t\\\\t'高二' \\\\n        \\\\t\\\\tWHEN t3.cla_Name LIKE '%高三%' THEN\\\\n        \\\\t\\\\t'高三' \\\\n        \\\\tEND AS 年级,\\\\n        \\\\tIF(t1.mes_Score < 60,1,0) 是否60分以下\\\\n        \\\\tFROM\\\\n        \\\\t\\\\t5_chengji t1,\\\\n        \\\\t\\\\t6_exam_type t2,\\\\n        \\\\t\\\\t2_student_info t3 \\\\n        \\\\tWHERE\\\\n        \\\\t\\\\tt1.exam_type = t2.EXAM_KIND_ID \\\\n        \\\\t\\\\tAND t1.mes_StudentID = t3.bf_StudentID \\\\n        \\\\t\\\\tAND t1.exam_term = '2018-2019-1' \\\\n        \\\\t\\\\tAND t1.mes_Score > 0 \\\\n        \\\\tAND t2.EXAM_KIND_NAME NOT LIKE '%平时%' \\\\n        \\\\tAND mes_sub_name != '')   t_a_0\\\\n    GROUP BY\\\\n        t_a_0.`考试类型`,\\\\n        t_a_0.`年级`,\\\\n        t_a_0.`科目`\\\\n    )   t_a_1\\\\nORDER BY\\\\n    f_ax_0 asc,\\\\n    f_ax_2 desc\\\\n LIMIT 0,1000\\\",\\\"drill\\\":false,\\\"drillFilters\\\":[],\\\"position\\\":\\\"panel\\\",\\\"xaxis\\\":\\\"[]\\\",\\\"xaxisExt\\\":\\\"[{\\\\\\\"id\\\\\\\":\\\\\\\"2da780c9-fac2-47f7-9115-2fa28aff0d09\\\\\\\",\\\\\\\"tableId\\\\\\\":\\\\\\\"1a3724e2-2a14-4093-aae6-409f1810dac4\\\\\\\",\\\\\\\"originName\\\\\\\":\\\\\\\"考试类型\\\\\\\",\\\\\\\"name\\\\\\\":\\\\\\\"考试类型\\\\\\\",\\\\\\\"dataeaseName\\\\\\\":\\\\\\\"C_c117d1236d7ffe24f66e2a6745e1ba73\\\\\\\",\\\\\\\"groupType\\\\\\