4bf8\\\",\\\"groupType\\\":\\\"q\\\",\\\"type\\\":\\\"BIGINT\\\",\\\"precision\\\":null,\\\"scale\\\":null,\\\"deType\\\":2,\\\"deExtractType\\\":2,\\\"extField\\\":0,\\\"checked\\\":true,\\\"columnIndex\\\":null,\\\"lastSyncTime\\\":null,\\\"dateFormat\\\":null,\\\"dateFormatType\\\":null,\\\"fieldShortName\\\":\\\"f_e980d91fe1474bf8\\\",\\\"desensitized\\\":null,\\\"params\\\":null},{\\\"id\\\":\\\"1726222889550\\\",\\\"datasourceId\\\":null,\\\"datasetTableId\\\":\\\"7240303643163889664\\\",\\\"datasetGroupId\\\":null,\\\"chartId\\\":null,\\\"originName\\\":\\\"NAME\\\",\\\"name\\\":\\\"NAME\\\",\\\"dbFieldName\\\":null,\\\"description\\\":\\\"NAME\\\",\\\"dataeaseName\\\":\\\"f_ecabc31d1ef3cedc\\\",\\\"groupType\\\":\\\"d\\\",\\\"type\\\":\\\"VARCHAR\\\",\\\"precision\\\":null,\\\"scale\\\":null,\\\"deType\\\":0,\\\"deExtractType\\\":0,\\\"extField\\\":0,\\\"checked\\\":true,\\\"columnIndex\\\":null,\\\"lastSyncTime\\\":null,\\\"dateFormat\\\":null,\\\"dateFormatType\\\":null,\\\"fieldShortName\\\":\\\"f_ecabc31d1ef3cedc\\\",\\\"desensitized\\\":null,\\\"params\\\":null}],\\\"childrenDs\\\":[],\\\"unionToParent\\\":{\\\"unionType\\\":\\\"left\\\",\\\"unionFields\\\":[],\\\"parentDs\\\":null,\\\"currentDs\\\":null,\\\"parentSQLObj\\\":null,\\\"currentSQLObj\\\":null},\\\"allChildCount\\\":0}]\",\"createBy\":\"1\",\"createTime\":1726222924226,\"qrtzInstance\":null,\"syncStatus\":null,\"updateBy\":\"1\",\"lastUpdateTime\":1726299216501,\"unionSql\":\"SELECT t_a_0.`problemNum` AS `f_27a12e9c02bce5bc`,t_a_0.`total` AS `f_b0560fa45becc2dd`,t_a_0.`normal` AS `f_e980d91fe1474bf8`,t_a_0.`NAME` AS `f_ecabc31d1ef3cedc` FROM (SELECT\\n    count(DISTINCT h.hostid) problemNum,\\n    (\\n        SELECT\\n            COUNT(hg.hostid)\\n        FROM\\n            hosts_groups hg\\n        WHERE\\n            hg.groupid = hs.groupid\\n    ) total,\\n    (\\n        SELECT\\n            COUNT(hg.hostid)\\n        FROM\\n            hosts_groups hg\\n        WHERE\\n            hg.groupid = hs.groupid\\n    ) - count(DISTINCT h.hostid) normal,\\n    hs. NAME\\nFROM\\n    problem p\\nLEFT JOIN (\\n    SELECT\\n        s1.triggerid,\\n        (\\n            SELECT\\n                s2.itemid\\n            FROM\\n                functions s2\\n            WHERE\\n                s2.triggerid = s1.triggerid\\n            LIMIT 1\\n        ) itemid\\n    FROM\\n        functions s1\\n    GROUP BY\\n        s1.triggerid\\n) f ON f.triggerid = p.objectid\\nLEFT JOIN `items` i ON i.itemid = f.itemid\\nLEFT JOIN `hosts` h ON h.hostid = i.hostid\\nLEFT JOIN hosts_groups hg ON hg.hostid = h.hostid\\nLEFT JOIN hstgrp hs ON hs.groupid = hg.groupid\\nWHERE\\n    ISNULL(p.r_eventid)\\nAND h. STATUS = 0\\nAND i.`status` = 0\\nGROUP BY\\n    hs. NAME,\\n    hs.groupid\\nORDER BY\\n    NAME) t_a_0\"},{\"id\":\"1032035774578692096\",\"name\":\"问题主机数据集\",\"pid\":\"1032034377489584128\",\"level\":0,\"nodeType\":\"dataset\",\"type\":null,\"mode\":0,\"info\":\"[{\\\"currentDs\\\":{\\\"id\\\":\\\"7240303749086842880\\\",\\\"name\\\":null,\\\"tableName\\\":\\\"自定义SQL\\\",\\\"datasourceId\\\":\\\"1032034278025859072\\\",\\\"datasetGroupId\\\":null,\\\"type\\\":\\\"sql\\\",\\\"info\\\":\\\"{\\\\\\\"table\\\\\\\":\\\\\\\"自定义SQL\\\\\\\",\\\\\\\"sql\\\\\\\":\\\\\\\"\\\\\\\"}\\\",\\\"sqlVariableDetails\\\":\\\"[]\\\",\\\"fields\\\":null,\\\"lastUpdateTime\\\":0,\\\"status\\\":null},\\\"currentDsField\\\":null,\\\"currentDsFields\\\":[{\\\"id\\\":\\\"1726222927347\\\",\\\"datasourceId\\\":null,\\\"datasetTableId\\\":\\\"7240303749086842880\\\",\\\"datasetGroupId\\\":null,\\\"chartId\\\":null,\\\"originName\\\":\\\"count\\\",\\\"name\\\":\\\"count\\\",\\\"dbFieldName\\\":null,\\\"description\\\":\\\"count\\\",\\\"dataeaseName\\\":\\\"f_2e3b9386c31ee8d7\\\",\\\"groupType\\\":\\\"q\\\",\\\"type\\\":\\\"BIGINT\\\",\\\"precision\\\":null,\\\"scale\\\":null,\\\"deType\\\":2,\\\"deExtractType\\\":2,\\\"extField\\\":0,\\\"checked\\\":true,\\\"columnIndex\\\":null,\\\"lastSyncTime\