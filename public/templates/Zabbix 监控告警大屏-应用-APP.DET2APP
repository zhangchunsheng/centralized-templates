oupType\\\":\\\"d\\\",\\\"type\\\":\\\"VARCHAR\\\",\\\"precision\\\":null,\\\"scale\\\":null,\\\"deType\\\":0,\\\"deExtractType\\\":0,\\\"extField\\\":0,\\\"checked\\\":true,\\\"columnIndex\\\":null,\\\"lastSyncTime\\\":null,\\\"dateFormat\\\":null,\\\"dateFormatType\\\":null,\\\"fieldShortName\\\":\\\"f_6931beb90f7ddf5c\\\",\\\"desensitized\\\":null,\\\"params\\\":null}],\\\"childrenDs\\\":[],\\\"unionToParent\\\":{\\\"unionType\\\":\\\"left\\\",\\\"unionFields\\\":[],\\\"parentDs\\\":null,\\\"currentDs\\\":null,\\\"parentSQLObj\\\":null,\\\"currentSQLObj\\\":null},\\\"allChildCount\\\":0}]\",\"createBy\":\"1\",\"createTime\":1726222844384,\"qrtzInstance\":null,\"syncStatus\":null,\"updateBy\":\"1\",\"lastUpdateTime\":1726222844384,\"unionSql\":\"SELECT t_a_0.`count` AS `f_2e3b9386c31ee8d7`,t_a_0.`severity` AS `f_1c66fc3de26236d6`,t_a_0.`severityName` AS `f_6931beb90f7ddf5c` FROM (SELECT\\n    COUNT(p.severity) count,\\n    p.severity,\\n    (\\n        CASE p.severity\\n        WHEN '0' THEN\\n            '未定义'\\n        WHEN '1' THEN\\n            '信息'\\n        WHEN '2' THEN\\n            '警告'\\n        WHEN '3' THEN\\n            '一般严重'\\n        WHEN '4' THEN\\n            '严重'\\n        WHEN p.severity = '5' THEN\\n            '灾难'\\n        ELSE\\n            '未知'\\n        END\\n    ) severityName\\nFROM\\n    problem p\\nLEFT JOIN (\\n    SELECT\\n        s1.triggerid,\\n        (\\n            SELECT\\n                s2.itemid\\n            FROM\\n                functions s2\\n            WHERE\\n                s2.triggerid = s1.triggerid\\n            LIMIT 1\\n        ) itemid\\n    FROM\\n        functions s1\\n    GROUP BY\\n        s1.triggerid\\n) f ON f.triggerid = p.objectid\\nLEFT JOIN `items` i ON i.itemid = f.itemid\\nLEFT JOIN `hosts` h ON h.hostid = i.hostid\\nLEFT JOIN `interface` inf ON inf.hostid = h.hostid\\nWHERE\\n    ISNULL(p.r_eventid)\\nAND h. STATUS = 0\\nAND i.`status` = 0\\nGROUP BY\\n    p.severity\\nORDER BY\\n    p.severity ASC) t_a_0\"},{\"id\":\"1032035428900933632\",\"name\":\"告警详情数据集\",\"pid\":\"1032034377489584128\",\"level\":0,\"nodeType\":\"dataset\",\"type\":null,\"mode\":0,\"info\":\"[{\\\"currentDs\\\":{\\\"id\\\":\\\"7240303446325202944\\\",\\\"name\\\":null,\\\"tableName\\\":\\\"自定义SQL\\\",\\\"datasourceId\\\":\\\"1032034278025859072\\\",\\\"datasetGroupId\\\":null,\\\"type\\\":\\\"sql\\\",\\\"info\\\":\\\"{\\\\\\\"table\\\\\\\":\\\\\\\"自定义SQL\\\\\\\",\\\\\\\"sql\\\\\\\":\\\\\\\"\\\\\\\"}\\\",\\\"sqlVariableDetails\\\":\\\"[]\\\",\\\"fields\\\":null,\\\"lastUpdateTime\\\":0,\\\"status\\\":null},\\\"currentDsField\\\":null,\\\"currentDsFields\\\":[{\\\"id\\\":\\\"1726222856286\\\",\\\"datasourceId\\\":null,\\\"datasetTableId\\\":\\\"7240303446325202944\\\",\\\"datasetGroupId\\\":null,\\\"chartId\\\":null,\\\"originName\\\":\\\"eventid\\\",\\\"name\\\":\\\"eventid\\\",\\\"dbFieldName\\\":null,\\\"description\\\":\\\"eventid\\\",\\\"dataeaseName\\\":\\\"f_7cf56f124fe84407\\\",\\\"groupType\\\":\\\"d\\\",\\\"type\\\":\\\"BIGINT UNSIGNED\\\",\\\"precision\\\":null,\\\"scale\\\":null,\\\"deType\\\":0,\\\"deExtractType\\\":0,\\\"extField\\\":0,\\\"checked\\\":true,\\\"columnIndex\\\":null,\\\"lastSyncTime\\\":null,\\\"dateFormat\\\":null,\\\"dateFormatType\\\":null,\\\"fieldShortName\\\":\\\"f_7cf56f124fe84407\\\",\\\"desensitized\\\":null,\\\"params\\\":null},{\\\"id\\\":\\\"1726222856287\\\",\\\"datasourceId\\\":null,\\\"datasetTableId\\\":\\\"7240303446325202944\\\",\\\"datasetGroupId\\\":null,\\\"chartId\\\":null,\\\"originName\\\":\\\"time\\\",\\\"name\\\":\\\"time\\\",\\\"dbFieldName\\\":null,\\\"description\\\":\\\"time\\\",\\\"dataeaseName\\\":\\\"f_5ad14aa950011db4\\\",\\\"groupType\\\":\\\"d\\\",\\\"type\\\":\\\"DATETIME\\\",\\\"precision\\\":null,\\\"scale\\\":null,\\\"deType\\\":1,\\\"deExtractType\\\":1,\\\"extField\\\":0,\\\"checked\\\":true,\\\"columnIndex\\\":null,\\\"lastSyncTime\\\":null,\\\"dateFormat\\\":null,\\\"dateFormatType\\\":null,\\\"fieldShortName\\\":\