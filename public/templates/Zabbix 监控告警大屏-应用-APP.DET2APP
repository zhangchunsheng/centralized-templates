3446325202944\\\",\\\"datasetGroupId\\\":null,\\\"chartId\\\":null,\\\"originName\\\":\\\"ip\\\",\\\"name\\\":\\\"ip\\\",\\\"dbFieldName\\\":null,\\\"description\\\":\\\"ip\\\",\\\"dataeaseName\\\":\\\"f_fb29cae42a44a80f\\\",\\\"groupType\\\":\\\"d\\\",\\\"type\\\":\\\"VARCHAR\\\",\\\"precision\\\":null,\\\"scale\\\":null,\\\"deType\\\":0,\\\"deExtractType\\\":0,\\\"extField\\\":0,\\\"checked\\\":true,\\\"columnIndex\\\":null,\\\"lastSyncTime\\\":null,\\\"dateFormat\\\":null,\\\"dateFormatType\\\":null,\\\"fieldShortName\\\":\\\"f_fb29cae42a44a80f\\\",\\\"desensitized\\\":null,\\\"params\\\":null},{\\\"id\\\":\\\"1726222856300\\\",\\\"datasourceId\\\":null,\\\"datasetTableId\\\":\\\"7240303446325202944\\\",\\\"datasetGroupId\\\":null,\\\"chartId\\\":null,\\\"originName\\\":\\\"PORT\\\",\\\"name\\\":\\\"PORT\\\",\\\"dbFieldName\\\":null,\\\"description\\\":\\\"PORT\\\",\\\"dataeaseName\\\":\\\"f_ab532a0afeeea6c3\\\",\\\"groupType\\\":\\\"d\\\",\\\"type\\\":\\\"VARCHAR\\\",\\\"precision\\\":null,\\\"scale\\\":null,\\\"deType\\\":0,\\\"deExtractType\\\":0,\\\"extField\\\":0,\\\"checked\\\":true,\\\"columnIndex\\\":null,\\\"lastSyncTime\\\":null,\\\"dateFormat\\\":null,\\\"dateFormatType\\\":null,\\\"fieldShortName\\\":\\\"f_ab532a0afeeea6c3\\\",\\\"desensitized\\\":null,\\\"params\\\":null}],\\\"childrenDs\\\":[],\\\"unionToParent\\\":{\\\"unionType\\\":\\\"left\\\",\\\"unionFields\\\":[],\\\"parentDs\\\":null,\\\"currentDs\\\":null,\\\"parentSQLObj\\\":null,\\\"currentSQLObj\\\":null},\\\"allChildCount\\\":0}]\",\"createBy\":\"1\",\"createTime\":1726222886172,\"qrtzInstance\":null,\"syncStatus\":null,\"updateBy\":\"1\",\"lastUpdateTime\":1726222886172,\"unionSql\":\"SELECT t_a_0.`eventid` AS `f_7cf56f124fe84407`,t_a_0.`time` AS `f_5ad14aa950011db4`,t_a_0.`clock` AS `f_3b373e86d278bd0c`,t_a_0.`pname` AS `f_cce1ccfc0079007b`,t_a_0.`acknowledged` AS `f_92a63af39c201a2c`,t_a_0.`severity` AS `f_1c66fc3de26236d6`,t_a_0.`severityName` AS `f_6931beb90f7ddf5c`,t_a_0.`objectid` AS `f_2720cea5beba14c4`,t_a_0.`status` AS `f_8fcfface5977b250`,t_a_0.`key_` AS `f_335f9cef46f89522`,t_a_0.`itemid` AS `f_fcff5348697318b1`,t_a_0.`HOST` AS `f_6f61ff6c88563d7b`,t_a_0.`NAME` AS `f_ecabc31d1ef3cedc`,t_a_0.`ip` AS `f_fb29cae42a44a80f`,t_a_0.`PORT` AS `f_ab532a0afeeea6c3` FROM (SELECT\\n    p.eventid,\\n    FROM_UNIXTIME(p.clock) time,\\n    p.clock,\\n    p. NAME pname,\\n    p.acknowledged,\\n    p.severity,\\n    (\\n        CASE p.severity\\n        WHEN '0' THEN\\n            '未定义'\\n        WHEN '1' THEN\\n            '信息'\\n        WHEN '2' THEN\\n            '警告'\\n        WHEN '3' THEN\\n            '一般严重'\\n        WHEN '4' THEN\\n            '严重'\\n        WHEN p.severity = '5' THEN\\n            '灾难'\\n        ELSE\\n            '未知'\\n        END\\n    ) severityName,\\n    p.objectid,\\n    i.`status`,\\n    i.key_,\\n    f.itemid,\\n    h. HOST,\\n    h. NAME,\\n    concat(inf.ip, \\\":\\\", inf. PORT) ip,\\n    inf. PORT\\nFROM\\n    problem p\\nLEFT JOIN (\\n    SELECT\\n        s1.triggerid,\\n        (\\n            SELECT\\n                s2.itemid\\n            FROM\\n                functions s2\\n            WHERE\\n                s2.triggerid = s1.triggerid\\n            LIMIT 1\\n        ) itemid\\n    FROM\\n        functions s1\\n    GROUP BY\\n        s1.triggerid\\n) f ON f.triggerid = p.objectid\\nLEFT JOIN `items` i ON i.itemid = f.itemid\\nLEFT JOIN `hosts` h ON h.hostid = i.hostid\\nLEFT JOIN `interface` inf ON inf.hostid = h.hostid\\nWHERE\\n    ISNULL(p.r_eventid)\\nAND h. STATUS = 0\\nAND i.`status` = 0\\nORDER BY\\n    clock DESC) t_a_0\"},{\"id\":\"1032035588510978048\",\"name\":\"告警主机组数据集\",\"pid\":\"1032034377489584128\",\"level\":0,\"nodeType\":\"dataset\",\"type\":null,\"mode\":0,\"info\":\"[{\\\"currentDs\\\":{\\\"id\\\":\\\"7240303643163889664\\\",\\\"name\\\":null,\\\"tableName\\\":\\\"自定义SQL\\\",\\\"datasourceId\\\":\\\"1032034278025859072\\\",\\\"datasetGroupId\\\":null,\\\"type\\\":\\\"sql\\\",\\\"info\\