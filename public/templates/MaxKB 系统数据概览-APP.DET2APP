ation\\\" \\\"a\\\"\\n   WHERE \\\"a\\\".\\\"model_id\\\" IS NOT NULL\\n   UNION SELECT \\\"a\\\".\\\"id\\\" AS \\\"app_id\\\",\\n                (node -> 'properties' -> 'node_data' ->> 'model_id')::uuid AS \\\"model_id\\\"\\n   FROM \\\"public\\\".\\\"application\\\" \\\"a\\\"\\n   CROSS JOIN jsonb_array_elements(\\\"a\\\".\\\"work_flow\\\" -> 'nodes') node\\n   WHERE \\\"a\\\".\\\"work_flow\\\" IS NOT NULL\\n     AND node -> 'properties' -> 'node_data' ? 'model_id')\\nSELECT \\\"m\\\".\\\"id\\\" AS \\\"模型ID\\\",\\n       \\\"m\\\".\\\"name\\\" AS \\\"模型名称\\\",\\n       COALESCE(SUM(\\\"acr\\\".\\\"message_tokens\\\"), 0) AS \\\"问题消耗token数量\\\",\\n       COALESCE(SUM(\\\"acr\\\".\\\"answer_tokens\\\"), 0) AS \\\"答案消耗token数量\\\",\\n       COALESCE(SUM(\\\"acr\\\".\\\"message_tokens\\\" + \\\"acr\\\".\\\"answer_tokens\\\"), 0) AS \\\"总token\\\"\\nFROM \\\"public\\\".\\\"application_chat_record\\\" \\\"acr\\\"\\nJOIN \\\"public\\\".\\\"application_chat\\\" \\\"ac\\\" ON \\\"acr\\\".\\\"chat_id\\\" = \\\"ac\\\".\\\"id\\\"\\nJOIN app_models \\\"am\\\" ON \\\"ac\\\".\\\"application_id\\\" = \\\"am\\\".\\\"app_id\\\"\\nJOIN \\\"public\\\".\\\"model\\\" \\\"m\\\" ON \\\"am\\\".\\\"model_id\\\" = \\\"m\\\".\\\"id\\\"\\nGROUP BY \\\"m\\\".\\\"id\\\",\\n         \\\"m\\\".\\\"name\\\") t_a_0\",\"isCross\":false},{\"id\":\"1149746990964412421\",\"name\":\"应用关联的知识库和文档数量\",\"pid\":\"1149746990918275072\",\"level\":0,\"nodeType\":\"dataset\",\"type\":null,\"mode\":0,\"info\":\"[{\\\"currentDs\\\":{\\\"id\\\":\\\"1149746991295762433\\\",\\\"name\\\":null,\\\"tableName\\\":\\\"自定义SQL\\\",\\\"datasourceId\\\":\\\"1149697291016343552\\\",\\\"datasetGroupId\\\":null,\\\"type\\\":\\\"sql\\\",\\\"info\\\":\\\"{\\\\\\\"table\\\\\\\":\\\\\\\"自定义SQL\\\\\\\",\\\\\\\"sql\\\\\\\":\\\\\\\"\\\\\\\"}\\\",\\\"sqlVariableDetails\\\":\\\"[]\\\",\\\"fields\\\":null,\\\"lastUpdateTime\\\":0,\\\"status\\\":null,\\\"isCross\\\":null},\\\"currentDsField\\\":null,\\\"currentDsFields\\\":[{\\\"id\\\":\\\