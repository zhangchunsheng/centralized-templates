[{\\\"id\\\":\\\"7ff9377f-e7e1-4063-bce5-b78a875c0024\\\",\\\"value\\\":\\\"其它\\\"}],\\\"quotaList\\\":[{\\\"id\\\":\\\"18dc4b45-37a2-455b-ad06-976a0b0d5abf\\\"}],\\\"field\\\":\\\"其它\\\",\\\"name\\\":\\\"其它\\\",\\\"category\\\":\\\"二区\\\",\\\"popSize\\\":null},{\\\"value\\\":4,\\\"dimensionList\\\":[{\\\"id\\\":\\\"7ff9377f-e7e1-4063-bce5-b78a875c0024\\\",\\\"value\\\":\\\"其它\\\"}],\\\"quotaList\\\":[{\\\"id\\\":\\\"116170b0-d29c-4c5d-85b4-2a521592bce7\\\"}],\\\"field\\\":\\\"其它\\\",\\\"name\\\":\\\"其它\\\",\\\"category\\\":\\\"三区\\\",\\\"popSize\\\":null}]},\\\"privileges\\\":null,\\\"isLeaf\\\":null,\\\"pid\\\":null,\\\"sql\\\":\\\"SELECT\\\\n    *\\\\nFROM\\\\n    (SELECT\\\\n        t_a_0.`职能` AS f_ax_0\\\\n        ,\\\\n        sum(CAST(t_a_0.`一区` AS DECIMAL(20,8))) AS f_ay_0,\\\\n        sum(CAST(t_a_0.`二区` AS DECIMAL(20,8))) AS f_ay_1,\\\\n        sum(CAST(t_a_0.`三区` AS DECIMAL(20,8))) AS f_ay_2\\\\n    FROM\\\\n        (SELECT\\\\n        \\\\tr.职能,\\\\n        \\\\tSUM(\\\\n        \\\\tIF\\\\n        \\\\t( r.`所属区域` = '一区', 1, 0 )) 一区,\\\\n        \\\\tSUM(\\\\n        \\\\tIF\\\\n        \\\\t( r.`所属区域` = '二区', 1, 0 )) 二区,\\\\n        \\\\tSUM(\\\\n        \\\\tIF\\\\n        \\\\t( r.`所属区域` = '三区', 1, 0 )) 三区 \\\\n        FROM\\\\n        \\\\t(\\\\n        \\\\tSELECT\\\\n        \\\\t\\\\tt.`所属区域`,\\\\n        \\\\t\\\\tt.`二级部门`,\\\\n        \\\\tCASE\\\\n        \\\\t\\\\t\\\\t\\\\n        \\\\t\\\\t\\\\tWHEN t.`二级部门` LIKE '%客户成功部' THEN\\\\n        \\\\t\\\\t\\\\t'项目咨询' \\\\n        \\\\t\\\\t\\\\tWHEN t.`二级部门` = '售前部' THEN\\\\n        \\\\t\\\\t\\\\t'售前' \\\\n        \\\\t\\\\t\\\\tWHEN t.`二级部门` LIKE '%交付%' THEN\\\\n        \\\\t\\\\t\\\\t'售后' \\\\n        \\\\t\\\\t\\\\tWHEN t.`二级部门` LIKE '%区%' THEN\\\\n        \\\\t\\\\t\\\\t'其它' ELSE '销售' \\\\n        \\\\t\\\\tEND 职能 \\\\n        FROM\\\\n        \\\\t`测试_在职人员信息` t \\\\n        WHERE\\\\n        \\\\tt.`所属区域` IN ( '一区', '二区', '三区' )) r group by r.职能)   t_a_0\\\\n    GROUP BY\\\\n        t_a_0.`职能`\\\\n    )   t_a_1\\\\n LIMIT 0,1000\\\",\\\"drill\\\":false,\\\"drillFilters\\\":[],\\\"position\\\":\\\"panel\\\",\\\"xaxisExt\\\":\\\"[]\\\",\\\"yaxis\\\":\\\"[{\\\\\\\"id\\\\\\\":\\\\\\\"ff821763-a4a6-47f9-a78e-955259671e3f\\\\\\\",\\\\\\\"tableId\\\\\\\":\\\\\\\"9743eb07-a7da-4f94-83fe-8a095bd701c4\\\\\\\",\\\\\\\"originName\\\\\\\":\\\\\\\"一区\\\\\\\",\\\\\\\"name\\\\\\\":\\\\\\\"一区\\\\\\\",\\\\\\\"dataeaseName\\\\\\\":\\\\\\\"C_6882b41631b2e30b0d66935f90e155ba\\\\\\\",\\\\\\\"groupType\\\\\\\":\\\\\\\"q\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"DECIMAL\\\\\\\",\\\\\\\"size\\\\\\\":24,\\\\\\\"deType\\\\\\\":3,\\\\\\\"deTypeFormat\\\\\\\":null,\\\\\\\"deExtractType\\\\\\\":3,\\\\\\\"extField\\\\\\\":0,\\\\\\\"checked\\\\\\\":true,\\\\\\\"columnIndex\\\\\\\":1,\\\\\\\"lastSyncTime\\\\\\\":1657701054139,\\\\\\\"sort\\\\\\\":\\\\\\\"none\\\\\\\",\\\\\\\"compareCalc\\\\\\\":{\\\\\\\"type\\\\\\\":\\\\\\\"none\\\\\\\",\\\\\\\"resultData\\\\\\\":\\\\\\\"percent\\\\\\\",\\\\\\\"field\\\\\\\":\\\\\\\"\\\\\\\",\\\\\\\"custom\\\\\\\":{\\\\\\\"field\\\\\\\":\\\\\\\"\\\\\\\",\\\\\\\"calcType\\\\\\\":\\\\\\\"0\\\\\\\",\\\\\\\"timeType\\\\\\\":\\\\\\\"0\\\\\\\",\\\\\\\"currentTime\\\\\\\":\\\\\\\"\\\\\\\",\\\\\\\"compareTime\\\\\\\":\\\\\\\"\\\\\\\",\\\\\\\"currentTimeRange\\\\\\\":[],\\\\\\\"compareTimeRange\\\\\\\":[]}},\\\\\\\"formatterCfg\\\\\\\":{\\\\\\\"type\\\\\\\":\\\\\\\"auto\\\\\\\",\\\\\\\"unit\\\\\\\":1,\\\\\\\"suffix\\\\\\\":\\\\\\\"\\\\\\\",\\\\\\\"decimalCount\\\\\\\":2,\\\\\\\"thousandSeparator\\\\\\\":true},\\\\\\\"chartType\\\\\\\":\\\\\\\"bar\\\\\\\",\\\\\\\"summary\\\\\\\":\\\\\\\"sum\\\\\\\",\\\\\\\"filter\\\\\\\":[]},{\\\\\\\"id\\\\\\\":\\\\\\\"18dc4b45-37a2-455b-ad06-976a0b0d5abf\\\\\\\",\\\\\\\"tableId\\\\\\\":\\\\\\\"9743eb07-a7da-4f94-83fe-8a095bd701c4\\\\\\\",\\\\\\\"originName\\\\\\\":\\\\\\\"二区\\\\\\\",\\\\\\\"name\\\\\\\":\\\\\\\"二区\\\\\\\",\\\\\\\"dataeaseName\\\\\\\":\\\\\\\"C_97e16ce265d78afe2dfdb53620abe919\\\\\\\",\\\\\\\"groupType\\\\\\\":\\\\\\