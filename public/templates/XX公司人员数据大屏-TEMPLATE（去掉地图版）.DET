0024\\\",\\\"value\\\":\\\"项目咨询\\\"}],\\\"quotaList\\\":[{\\\"id\\\":\\\"ff821763-a4a6-47f9-a78e-955259671e3f\\\"}],\\\"field\\\":\\\"项目咨询\\\",\\\"name\\\":\\\"项目咨询\\\",\\\"category\\\":\\\"一区\\\",\\\"popSize\\\":null},{\\\"value\\\":3,\\\"dimensionList\\\":[{\\\"id\\\":\\\"7ff9377f-e7e1-4063-bce5-b78a875c0024\\\",\\\"value\\\":\\\"项目咨询\\\"}],\\\"quotaList\\\":[{\\\"id\\\":\\\"18dc4b45-37a2-455b-ad06-976a0b0d5abf\\\"}],\\\"field\\\":\\\"项目咨询\\\",\\\"name\\\":\\\"项目咨询\\\",\\\"category\\\":\\\"二区\\\",\\\"popSize\\\":null},{\\\"value\\\":4,\\\"dimensionList\\\":[{\\\"id\\\":\\\"7ff9377f-e7e1-4063-bce5-b78a875c0024\\\",\\\"value\\\":\\\"项目咨询\\\"}],\\\"quotaList\\\":[{\\\"id\\\":\\\"116170b0-d29c-4c5d-85b4-2a521592bce7\\\"}],\\\"field\\\":\\\"项目咨询\\\",\\\"name\\\":\\\"项目咨询\\\",\\\"category\\\":\\\"三区\\\",\\\"popSize\\\":null},{\\\"value\\\":14,\\\"dimensionList\\\":[{\\\"id\\\":\\\"7ff9377f-e7e1-4063-bce5-b78a875c0024\\\",\\\"value\\\":\\\"售后\\\"}],\\\"quotaList\\\":[{\\\"id\\\":\\\"ff821763-a4a6-47f9-a78e-955259671e3f\\\"}],\\\"field\\\":\\\"售后\\\",\\\"name\\\":\\\"售后\\\",\\\"category\\\":\\\"一区\\\",\\\"popSize\\\":null},{\\\"value\\\":9,\\\"dimensionList\\\":[{\\\"id\\\":\\\"7ff9377f-e7e1-4063-bce5-b78a875c0024\\\",\\\"value\\\":\\\"售后\\\"}],\\\"quotaList\\\":[{\\\"id\\\":\\\"18dc4b45-37a2-455b-ad06-976a0b0d5abf\\\"}],\\\"field\\\":\\\"售后\\\",\\\"name\\\":\\\"售后\\\",\\\"category\\\":\\\"二区\\\",\\\"popSize\\\":null},{\\\"value\\\":16,\\\"dimensionList\\\":[{\\\"id\\\":\\\"7ff9377f-e7e1-4063-bce5-b78a875c0024\\\",\\\"value\\\":\\\"售后\\\"}],\\\"quotaList\\\":[{\\\"id\\\":\\\"116170b0-d29c-4c5d-85b4-2a521592bce7\\\"}],\\\"field\\\":\\\"售后\\\",\\\"name\\\":\\\"售后\\\",\\\"category\\\":\\\"三区\\\",\\\"popSize\\\":null},{\\\"value\\\":4,\\\"dimensionList\\\":[{\\\"id\\\":\\\"7ff9377f-e7e1-4063-bce5-b78a875c0024\\\",\\\"value\\\":\\\"其它\\\"}],\\\"quotaList\\\":[{\\\"id\\\":\\\"ff821763-a4a6-47f9-a78e-955259671e3f\\\"}],\\\"field\\\":\\\"其它\\\",\\\"name\\\":\\\"其它\\\",\\\"category\\\":\\\"一区\\\",\\\"popSize\\\":null},{\\\"value\\\":4,\\\"dimensionList\\\":[{\\\"id\\\":\\\"7ff9377f-e7e1-4063-bce5-b78a875c0024\\\",\\\"value\\\":\\\"其它\\\"}],\\\"quotaList\\\":[{\\\"id\\\":\\\"18dc4b45-37a2-455b-ad06-976a0b0d5abf\\\"}],\\\"field\\\":\\\"其它\\\",\\\"name\\\":\\\"其它\\\",\\\"category\\\":\\\"二区\\\",\\\"popSize\\\":null},{\\\"value\\\":4,\\\"dimensionList\\\":[{\\\"id\\\":\\\"7ff9377f-e7e1-4063-bce5-b78a875c0024\\\",\\\"value\\\":\\\"其它\\\"}],\\\"quotaList\\\":[{\\\"id\\\":\\\"116170b0-d29c-4c5d-85b4-2a521592bce7\\\"}],\\\"field\\\":\\\"其它\\\",\\\"name\\\":\\\"其它\\\",\\\"category\\\":\\\"三区\\\",\\\"popSize\\\":null}]},\\\"privileges\\\":null,\\\"isLeaf\\\":null,\\\"pid\\\":null,\\\"sql\\\":\\\"SELECT\\\\n    *\\\\nFROM\\\\n    (SELECT\\\\n        t_a_0.`职能` AS f_ax_0\\\\n        ,\\\\n        sum(CAST(t_a_0.`一区` AS DECIMAL(20,8))) AS f_ay_0,\\\\n        sum(CAST(t_a_0.`二区` AS DECIMAL(20,8))) AS f_ay_1,\\\\n        sum(CAST(t_a_0.`三区` AS DECIMAL(20,8))) AS f_ay_2\\\\n    FROM\\\\n        (SELECT\\\\n        \\\\tr.职能,\\\\n        \\\\tSUM(\\\\n        \\\\tIF\\\\n        \\\\t( r.`所属区域` = '一区', 1, 0 )) 一区,\\\\n        \\\\tSUM(\\\\n        \\\\tIF\\\\n        \\\\t( r.`所属区域` = '二区', 1, 0 )) 二区,\\\\n        \\\\tSUM(\\\\n        \\\\tIF\\\\n        \\\\t( r.`所属区域` = '三区', 1, 0 )) 三区 \\\\n        FROM\\\\n        \\\\t(\\\\n        \\\\tSELECT\\\\n        \\\\t\\\\tt.`所属区域`,\\\\n        \\\\t\\\\tt.`二级部门`,\\\\n        \\\\tCASE\\\\n        \\\\t\\\\t\\\\t\\\\n        \\\\t\\\\t\\\\tWHEN t.`二级部门` LIKE '%客户成功部' THEN\\\\n        \\\\t\\\\t\\\\t'项目咨询' \\\\n        \\\\t\\\\t\\\\tWHEN t.`二级部门` = '售前部' THEN\\\\n        \\\\t\\\\t\\\\t'售前' \\\\n        \\\\t\\\\t\\\\tWHEN t.`二级部门` LIKE '%交付%' THEN\\\\n        \\\\t\\\\t\\\\t'售后' \\\\n        \\\\t\\\\t\\\\tWHEN t.`二级部门` LIKE '%区%' THEN\\\\n        \\\\t\\\\t\\\\t'其它' ELSE '销售' \\\\n        \\\\t\\\\tEND 职能 \\\\n        FROM\\\\n        \\\\t`测试_在职人员信息` t \\\\n        WHERE\\\\n        \\\\tt.`所属区域` IN ( '一区',