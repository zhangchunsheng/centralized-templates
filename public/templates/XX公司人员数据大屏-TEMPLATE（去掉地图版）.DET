\\\"category\\\":\\\"南区\\\",\\\"popSize\\\":null},{\\\"value\\\":19,\\\"dimensionList\\\":[{\\\"id\\\":\\\"b9fa745a-b6ee-4129-9f5c-8639b5cdfb6d\\\",\\\"value\\\":\\\"CE 交付\\\"}],\\\"quotaList\\\":[{\\\"id\\\":\\\"a7718a92-93b3-4dc7-9397-a494adf2fc8a\\\"}],\\\"field\\\":\\\"CE 交付\\\",\\\"name\\\":\\\"CE 交付\\\",\\\"category\\\":\\\"北区\\\",\\\"popSize\\\":null},{\\\"value\\\":4,\\\"dimensionList\\\":[{\\\"id\\\":\\\"b9fa745a-b6ee-4129-9f5c-8639b5cdfb6d\\\",\\\"value\\\":\\\"总经理/助理\\\"}],\\\"quotaList\\\":[{\\\"id\\\":\\\"290dea6b-516a-4021-93f9-9fb24d5242c8\\\"}],\\\"field\\\":\\\"总经理/助理\\\",\\\"name\\\":\\\"总经理/助理\\\",\\\"category\\\":\\\"东区\\\",\\\"popSize\\\":null},{\\\"value\\\":4,\\\"dimensionList\\\":[{\\\"id\\\":\\\"b9fa745a-b6ee-4129-9f5c-8639b5cdfb6d\\\",\\\"value\\\":\\\"总经理/助理\\\"}],\\\"quotaList\\\":[{\\\"id\\\":\\\"79fd2949-8d57-443a-80d3-83bbd6518d1c\\\"}],\\\"field\\\":\\\"总经理/助理\\\",\\\"name\\\":\\\"总经理/助理\\\",\\\"category\\\":\\\"南区\\\",\\\"popSize\\\":null},{\\\"value\\\":4,\\\"dimensionList\\\":[{\\\"id\\\":\\\"b9fa745a-b6ee-4129-9f5c-8639b5cdfb6d\\\",\\\"value\\\":\\\"总经理/助理\\\"}],\\\"quotaList\\\":[{\\\"id\\\":\\\"a7718a92-93b3-4dc7-9397-a494adf2fc8a\\\"}],\\\"field\\\":\\\"总经理/助理\\\",\\\"name\\\":\\\"总经理/助理\\\",\\\"category\\\":\\\"北区\\\",\\\"popSize\\\":null}]},\\\"privileges\\\":null,\\\"isLeaf\\\":null,\\\"pid\\\":null,\\\"sql\\\":\\\"SELECT\\\\n    *\\\\nFROM\\\\n    (SELECT\\\\n        t_a_0.`职能` AS f_ax_0\\\\n        ,\\\\n        sum(CAST(t_a_0.`东区` AS DECIMAL(20,8))) AS f_ay_0,\\\\n        sum(CAST(t_a_0.`南区` AS DECIMAL(20,8))) AS f_ay_1,\\\\n        sum(CAST(t_a_0.`北区` AS DECIMAL(20,8))) AS f_ay_2\\\\n    FROM\\\\n        (SELECT\\\\n        \\\\tr.职能,\\\\n        \\\\tSUM(\\\\n        \\\\tIF\\\\n        \\\\t( r.`所属区域` = '东区', 1, 0 )) 东区,\\\\n        \\\\tSUM(\\\\n        \\\\tIF\\\\n        \\\\t( r.`所属区域` = '南区', 1, 0 )) 南区,\\\\n        \\\\tSUM(\\\\n        \\\\tIF\\\\n        \\\\t( r.`所属区域` = '北区', 1, 0 )) 北区 \\\\n        FROM\\\\n        \\\\t(\\\\n        \\\\tSELECT\\\\n        \\\\t\\\\tt.`所属区域`,\\\\n        \\\\t\\\\tt.`二级部门`,\\\\n        \\\\tCASE\\\\n        \\\\t\\\\t\\\\t\\\\n        \\\\t\\\\t\\\\tWHEN t.`二级部门` LIKE '%客户成功部' THEN\\\\n        \\\\t\\\\t\\\\t'客户成功' \\\\n        \\\\t\\\\t\\\\tWHEN t.`二级部门` = '售前部' THEN\\\\n        \\\\t\\\\t\\\\t'售前' \\\\n        \\\\t\\\\t\\\\tWHEN t.`二级部门` LIKE '%交付%' THEN\\\\n        \\\\t\\\\t\\\\t'CE 交付' \\\\n        \\\\t\\\\t\\\\tWHEN t.`二级部门` LIKE '%区%' THEN\\\\n        \\\\t\\\\t\\\\t'总经理/助理' ELSE '销售' \\\\n        \\\\t\\\\tEND 职能 \\\\n        FROM\\\\n        \\\\t`在职人员信息` t \\\\n        WHERE\\\\n        \\\\tt.`所属区域` IN ( '东区', '南区', '北区' )) r group by r.职能)   t_a_0\\\\n    GROUP BY\\\\n        t_a_0.`职能`\\\\n    )   t_a_1\\\\n LIMIT 0,1000\\\",\\\"drill\\\":false,\\\"drillFilters\\\":[],\\\"position\\\":\\\"panel\\\",\\\"xaxisExt\\\":\\\"[]\\\",\\\"yaxis\\\":\\\"[{\\\\\\\"id\\\\\\\":\\\\\\\"290dea6b-516a-4021-93f9-9fb24d5242c8\\\\\\\",\\\\\\\"tableId\\\\\\\":\\\\\\\"ffc5adff-d1c2-4ddd-9cc0-51204034b9ad\\\\\\\",\\\\\\\"originName\\\\\\\":\\\\\\\"东区\\\\\\\",\\\\\\\"name\\\\\\\":\\\\\\\"东区\\\\\\\",\\\\\\\"dataeaseName\\\\\\\":\\\\\\\"C_46ad89cc355d86a315ee5d73e285302c\\\\\\\",\\\\\\\"groupType\\\\\\\":\\\\\\\"q\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"DECIMAL\\\\\\\",\\\\\\\"size\\\\\\\":24,\\\\\\\"deType\\\\\\\":3,\\\\\\\"deTypeFormat\\\\\\\":null,\\\\\\\"deExtractType\\\\\\\":3,\\\\\\\"extField\\\\\\\":0,\\\\\\\"checked\\\\\\\":true,\\\\\\\"columnIndex\\\\\\\":2,\\\\\\\"lastSyncTime\\\\\\\":1656993844730,\\\\\\\"sort\\\\\\\":\\\\\\\"none\\\\\\\",\\\\\\\"chartType\\\\\\\":\\\\\\\"bar\\\\\\\",\\\\\\\"summary\\\\\\\":\\\\\\\"sum\\\\\\\",\\\\\\\"filter\\\\\\\":[],\\\\\\\"compareCalc\\\\\\\":{\\\\\\\"type\\\\\\\":\\\\\\\"none\\\\\\\",\\\\\\\"resultData\\\\\\\":\\\\\\\"percent\\\\\\\",\\\\\\\"field\\\\\\\":\\\\\\\"\\\\\\\",\\\\\\\"custom\\\\\\\":{\\\\\\\"field\\\\\\\":\\\\\\\"\\\\\\\",\\\\\\\"calcType\\\\\\\":\\\\\\\"0\\\\\\\",\\\\\\\"timeType\\\\\