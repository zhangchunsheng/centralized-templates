,\"editing\":false,\"canvasActive\":false,\"x\":8,\"y\":43,\"sizeX\":16,\"sizeY\":7,\"style\":{\"rotate\":0,\"opacity\":1,\"width\":664.8888888888889,\"height\":345.7222222222222,\"left\":290.8888888888889,\"top\":2074.333333333333},\"matrixStyle\":{},\"commonBackground\":{\"backgroundColorSelect\":true,\"backgroundImageEnable\":true,\"backgroundType\":\"outerImage\",\"innerImage\":\"board/board_1.svg\",\"outerImage\":\"/static-resource/7167770761065664512.png\",\"innerPadding\":10,\"borderRadius\":0,\"backgroundColor\":\"#1B635E0D\",\"innerImageColor\":\"rgba(16, 148, 229, 1)\"},\"state\":\"ready\",\"render\":\"antv\",\"id\":\"7177382436189288734\",\"_dragId\":16,\"show\":true,\"linkageFilters\":[],\"maintainRadio\":false,\"aspectRatio\":1},{\"animations\":[],\"canvasId\":\"canvas-main\",\"events\":{},\"groupStyle\":{},\"isLock\":false,\"isShow\":true,\"collapseName\":[\"position\",\"background\",\"style\",\"picture\"],\"linkage\":{\"duration\":0,\"data\":[{\"id\":\"\",\"label\":\"\",\"event\":\"\",\"style\":[{\"key\":\"\",\"value\":\"\"}]}]},\"component\":\"UserView\",\"name\":\"富文本\",\"label\":\"富文本\",\"propValue\":{\"textValue\":\"<p style=\\\"margin-top: 10px; color: #172b4d; font-family: -apple-system, 'system-ui', 'Segoe UI', Roboto, Oxygen, Ubuntu, 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif; font-size: 14px; line-height: 1.5; text-align: center;\\\"><strong><span style=\\\"font-size: 14px;\\\"><span style=\\\"font-family: STFangsong;\\\"><span style=\\\"color: #076655; text-align: justify;\\\">从 2012 年到 2020 年的九年间</span></span></span></strong></p>\\n<p style=\\\"margin-top: 10px; color: #172b4d; font-family: -apple-system, 'system-ui', 'Segoe UI', Roboto, Oxygen, Ubuntu, 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif; font-size: 14px; line-height: 1.5; text-align: center;\\\"><strong><span style=\\\"font-size: 14px;\\\"><span style=\\\"font-family: STFangsong;\\\"><span style=\\\"color: #191919; text-align: justify;\\\"><span style=\\\"color: #e03e2d;\\\">煤炭</span><span style=\\\"color: #076655;\\\">进口量</span><span style=\\\"color: #e03e2d;\\\">涨幅较小</span></span></span></span></strong></p>\\n<p style=\\\"margin-top: 10px; color: #172b4d; font-family: -apple-system, 'system-ui', 'Segoe UI', Roboto, Oxygen, Ubuntu, 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif; font-size: 14px; line-height: 1.5; text-align: center;\\\"><strong><span style=\\\"font-size: 14px;\\\"><span style=\\\"font-family: STFangsong;\\\"><span style=\\\"color: #e03e2d; text-align: justify;\\\">天然气</span><span style=\\\"color: #191919; text-align: justify;\\\"><span style=\\\"color: #076655;\\\">进口量</span><span style=\\\"color: #e03e2d;\\\">增长</span><span style=\\\"color: #076655;\\\">了&nbsp;</span><span style=\\\"color: #e03e2d;\\\">2&nbsp;倍多</span></span></span></span></strong></p>\\n<p style=\\\"margin-top: 10px; color: #172b4d; font-family: -apple-system, 'system-ui', 'Segoe UI', Roboto, Oxygen, Ubuntu, 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif; font-size: 14px; line-height: 1.5; text-align: center;\\\"><strong><span style=\\\"font-size: 14px;\\\"><span style=\\\"font-family: STFangsong;\\\"><span style=\\\"color: #191919; text-align: justify;\\\"><span style=\\\"color: #076655;\\\">对外依存度</span></span></span><span style=\\\"font-family: STFangsong;\\\"><span style=\\\"color: #191919; text-align: justify;\\\"><span style=\\\"color: #076655;\\\">则增长了近</span></span><span style=\\\"color: #191919; text-align: justify;\\\">&nbsp;</span><span style=\\\"color: #191919; text-align: justify;\\\"><span style=\\\"color: #e03e2d;\\\">18.6</span></span></span><span style=\\\"font-family: STFangsong;\\\"><span style=\\\"color: #191919; text-align: justify;\\\">&nbsp;</span></span><span style=\\\"font-family: STFangsong;\\\"><span style=\\\"color: #191919; text-align: justify;\\\"><span style=\\\"color: #076655;\\\">个百分点</span></span></span></span></strong></p>\\n<p style=\\\"margin-top: 10px; color: #172b4d; font-family: -apple-system, 'system-ui', 'Segoe UI', Roboto, Oxygen, Ubuntu, 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif; font-size: 14px; line-height: 1.5; text-align: center;\\\"><strong><span style=\\\"font-size: 14px;\\\"><span style=\\\"font-family: STFangsong;\\\"><span style=\\\"color: #191919; text-align: justify;\\\"><span style=\\\"color: #e03e2d;\\\">原油</span><span style=\\\"color: #076655;\\\">进口量</span></span></span><span style=\\\"font-family: STFangsong;\\\"><span style=\\\"color: #191919; text-align: justify;\\\"><span style=\\\"color: #e03e2d;\\\">增长</span><span style=\\\"color: #076655;\\\">了</span><span style=\\\"color: #e03e2d;\\\">近一倍</span></span></span></span></strong></p>\\n<p style=\\\"margin-top: 10px; color: #172b4d; font-family: -apple-system, 'system-ui', 'Segoe UI', Roboto, Oxygen, Ubuntu, 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif; font-size: 14px; line-height: 1.5; text-align: center;\\\"><strong><span style=\\\"font-size: 14px;\\\"><span style=\\\"font-family: STFangsong;\\\"><span style=\\\"color: #191919; text-align: justify;\\\"><span style=\\\"color: #076655;\\\">对外依存度则增长了</span></span></span><span style=\\\"font-family: STFangsong;\\\"><span style=\\\"color: #191919; text-align: justify;\\\">&nbsp;<span style=\\\"color: #e03e2d;\\\">20.29&nbsp;</span></span></span><span style=\\\"font-family: STFangsong;\\\"><span style=\\\"color: #191919; text-align: justify;\\\"><span style=\\\"color: #076655;\\\">个百分点</span></span></span></span></strong></p>\\n<p style=\\\"margin-top: 10px; color: #172b4d; font-family: -apple-system, 'system-ui', 'Segoe UI', Roboto, Oxygen, Ubuntu, 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif; font-size: 14px; line-height: 1.5; text-align: center;\\\">&nbsp;</p>\\n<p style=\\\"margin-top: 10px; color: #172b4d; font-family: -apple-system, 'system-ui', 'Segoe UI', Roboto, Oxygen, Ubuntu, 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif; font-size: 14px; line-height: 1.5; text-