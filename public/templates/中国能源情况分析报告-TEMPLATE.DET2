how\":true,\"collapseName\":[\"position\",\"background\",\"style\",\"picture\"],\"linkage\":{\"duration\":0,\"data\":[{\"id\":\"\",\"label\":\"\",\"event\":\"\",\"style\":[{\"key\":\"\",\"value\":\"\"}]}]},\"component\":\"UserView\",\"name\":\"富文本\",\"label\":\"富文本\",\"propValue\":{\"textValue\":\"<h1 style=\\\"text-align: center; line-height: 1.4;\\\"><span style=\\\"font-size: 24px;\\\"><strong>电产量分析</strong></span></h1>\"},\"icon\":\"bar\",\"innerType\":\"rich-text\",\"editing\":false,\"canvasActive\":false,\"x\":1,\"y\":3,\"sizeX\":36,\"sizeY\":2,\"style\":{\"rotate\":0,\"opacity\":1,\"width\":1496,\"height\":98.77777777777777,\"left\":0,\"top\":98.77777777777777},\"matrixStyle\":{},\"commonBackground\":{\"backgroundColorSelect\":true,\"backgroundImageEnable\":true,\"backgroundType\":\"outerImage\",\"innerImage\":\"board/board_1.svg\",\"outerImage\":\"/static-resource/7167767822620168192.png\",\"innerPadding\":12,\"borderRadius\":0,\"backgroundColor\":\"rgba(27, 99, 94, 0.05)\",\"innerImageColor\":\"rgba(16, 148, 229, 1)\"},\"state\":\"prepare\",\"render\":\"custom\",\"id\":\"7177366344238676254\",\"_dragId\":1,\"show\":true,\"linkageFilters\":[],\"maintainRadio\":false,\"aspectRatio\":1},{\"animations\":[],\"canvasId\":\"canvas-main\",\"events\":{},\"groupStyle\":{},\"isLock\":false,\"isShow\":true,\"collapseName\":[\"position\",\"background\",\"style\",\"picture\"],\"linkage\":{\"duration\":0,\"data\":[{\"id\":\"\",\"label\":\"\",\"event\":\"\",\"style\":[{\"key\":\"\",\"value\":\"\"}]}]},\"component\":\"UserView\",\"name\":\"富文本\",\"label\":\"富文本\",\"propValue\":{\"textValue\":\"<p style=\\\"margin-top: 10px; color: #172b4d; font-family: -apple-system, 'system-ui', 'Segoe UI', Roboto, Oxygen, Ubuntu, 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif; font-size: 14px; line-height: 2; text-align: center;\\\"><strong><span style=\\\"font-family: STFangsong;\\\"><span style=\\\"font-size: 14px; color: #076655;\\\">2012 - 2020 的 9 年间</span></span></strong></p>\\n<p style=\\\"margin-top: 10px; color: #172b4d; font-family: -apple-system, 'system-ui', 'Segoe UI', Roboto, Oxygen, Ubuntu, 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif; font-size: 14px; line-height: 2; text-align: center;\\\"><strong><span style=\\\"font-family: STFangsong;\\\"><span style=\\\"font-size: 14px; color: #000000;\\\"><span style=\\\"color: #076655; font-size: 18px;\\\"><span style=\\\"font-size: 20px;\\\">虽然</span>&nbsp;</span><span style=\\\"color: #e03e2d;\\\">火电依然是主体</span></span></span></strong></p>\\n<p style=\\\"margin-top: 10px; color: #172b4d; font-family: -apple-system, 'system-ui', 'Segoe UI', Roboto, Oxygen, Ubuntu, 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif; font-size: 14px; line-height: 2; text-align: center;\\\"><strong><span style=\\\"font-family: STFangsong;\\\"><span style=\\\"font-size: 14px; color: #076655;\\\"><span style=\\\"font-size: 20px;\\\">但是&nbsp;</span>核能、风能、水能</span></span></strong></p>\\n<p style=\\\"margin-top: 10px; color: #172b4d; font-family: -apple-system, 'system-ui', 'Segoe UI', Roboto, Oxygen, Ubuntu, 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif; font-size: 14px; line-height: 2; text-align: center;\\\"><strong><span style=\\\"font-family: STFangsong;\\\"><span style=\\\"font-size: 14px; color: #000000;\\\"><span style=\\\"color: #076655;\\\">三种</span><span style=\\\"color: #e03e2d;\\\">清洁能源</span><span style=\\\"color: #076655;\\\">的总发电量</span></span></span></strong></p>\\n<p style=\\\"margin-top: 10px; color: #172b4d; font-family: -apple-system, 'system-ui', 'Segoe UI', Roboto, Oxygen, Ubuntu, 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif; font-size: 14px; line-height: 2; text-align: center;\\\"><strong><span style=\\\"font-family: STFangsong;\\\"><span style=\\\"font-size: 14px; color: #000000;\\\"><span style=\\\"color: #076655;\\\">从 2012 年的</span>&nbsp;<span style=\\\"color: #e03e2d;\\\">10654.8&nbsp;<span style=\\\"color: #076655;\\\">亿千瓦小时</span></span></span></span></strong></p>\\n<p style=\\\"margin-top: 10px; color: #172b4d; font-family: -apple-system, 'system-ui', 'Segoe UI', Roboto, Oxygen, Ubuntu, 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif; font-size: 14px; line-height: 2; text-align: center;\\\"><strong><span style=\\\"font-family: STFangsong;\\\"><span style=\\\"font-size: 14px; color: #000000;\\\"><span style=\\\"color: #076655;\\\">提高到 2020 年的</span>&nbsp;<span style=\\\"color: #e03e2d;\\\">21879.3&nbsp;<span style=\\\"color: #076655;\\\">亿千瓦小时</span></span></span></span></strong></p>\\n<p style=\\\"margin-top: 10px; color: #172b4d; font-family: -apple-system, 'system-ui', 'Segoe UI', Roboto, Oxygen, Ubuntu, 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif; font-size: 14px; line-height: 2; text-align: center;\\\"><strong><span style=\\\"font-family: STFangsong;\\\"><span style=\\\"font-size: 14px; color: #000000;\\\"><span style=\\\"color: #076655;\\\">实现了</span><span style=\\\"color: #e03e2d; font-size: 20px;\\\">产量翻倍</span></span></span></strong></p>\\n<p style=\\\"margin-top: 10px; color: #172b4d; font-family: -apple-system, 'system-ui', 'Segoe UI', Roboto, Oxygen, Ubuntu, 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif; font-size: 14px; line-height: 2; text-align: center;\\\">&nbsp;</p>\\n<p style=\\\"margin-top: 10px; color: #172b4d; font-family: -apple-system, 'system-ui', 'Segoe UI', Roboto, Oxygen, Ubuntu, 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif; font-size: 14px; line-height: 2; text-align: center;\\\"><strong><span style=\\\"font-family: STFangsong;\\\"><span style=\\\"font-size: 14px; color: #000000;\\\"><span style=\\\"color: #076655;\\\">其中</span><span style=\\\"color: #e03e2d;\\\">核电</span><span style=\\\"color: #076655;\\\">产量翻了近</span>&nbsp;<span style=\\\"color: #e03e2d;\\\">3 倍</span></span></span></strong></p>\\n<p style=\\\"margin-top: 10px; color: #172b4d; font-family: -apple-system, 'system-ui', 'Segoe UI', Roboto, Oxygen, Ubuntu, 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif; font-size: 14px; line-height: 2; text-align: center;\\\"><strong><span style=\\\"font-family: STFangsong;\\\"><span style=\\\"font-size: 14px; color: #000000;\\\"><span style=\\\"color: #e03e2d;\\\">风电</span><span style=\\\"color: #076655;\\\">产量翻了近</span>&nbsp;<span style=\\\"color: #e03e2d;\\\">4 倍</span>。</span></span></strong></p>\"},\"icon\":\"bar\",\"innerType\":\"rich-text\",\"editing\":false,\"canvasActive\":false,\"x\":1,\"y\":5,\"sizeX\":7,\"sizeY\":12,\"style\":{\"rotate\":0,\"opacity\":1,\"width\":290.8888888888889,\"height\":592.6666666666666,\"left\":0,\"top\":197.55555555555554},\"matrixStyle\":{},\"commonBackground\":{\"backgroundColorSelect\":true,\"backgroundImageEnable\":true,\"backgroundType\":\"outerImage\",\"innerImage\":\"board/board_9.svg\",\"outerImage\":\"/static-resource/7168130658869448704.png\",\"innerPadding\":12,\"borderRadius\":0,\"backgroundColor\":\"rgba(27, 99, 94, 0.05)\",\"innerImageColor\":\"rgba(16, 148, 229, 1)\"},\"state\":\"ready\",\"render\":\"custom\",\"id\":\"7177367620464720158\",\"_dragId\":2,\"show\":true,\"linkageFilters\":[],\"maintainRadio\":false,\"aspectRatio\":1},{\"animations\":[],\"canvasId\":\"canvas-main\",\"events\":{},\"groupStyle\":{},\"isLock\":false,\"isShow\":true,\"collapseName\":[\"position\",\"background\",\"style\",\"picture\"],\"linkage\":{\"duration\":0,\"data\":[{\"id\":\"\",\"label\":\"\",\"event\":\"\",\"style\":[{\"key\":\"\",\"value\":\"\"}]}]},\"component\":\"UserView\",\"name\":\"基础柱状图\",\"label\":\"基础柱状图\",\"propValue\":{\"textValue\":\"\"},\"icon\":\"bar\",\"innerType\":\"bar\",\"editing\":false,\"canvasActive\":false,\"x\":8,\"y\":5,\"sizeX\":21,\"sizeY\":6,\"style\":{\"rotate\":0,\"opacity\":1,\"width\":872.6666666666667,\"height\":296.3333333333333,\"left\":290.8888888888889,\"top\":197.55555555555554},\"matrixStyle\":{},\"commonBackground\":{\"backgroundColorSelect\":true,\"backgroundImageEnable\":true,\"backgroundType\":\"outerImage\",\"inne