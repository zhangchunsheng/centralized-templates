yle\":{},\"commonBackground\":{\"backgroundColorSelect\":true,\"backgroundImageEnable\":true,\"backgroundType\":\"outerImage\",\"innerImage\":\"board/board_1.svg\",\"outerImage\":\"/static-resource/7167772432172847104.png\",\"innerPadding\":12,\"borderRadius\":0,\"backgroundColor\":\"#1B635E0D\",\"innerImageColor\":\"rgba(16, 148, 229, 1)\"},\"state\":\"ready\",\"render\":\"antv\",\"id\":\"7177374775360141598\",\"_dragId\":8,\"show\":true,\"linkageFilters\":[],\"maintainRadio\":false,\"aspectRatio\":1},{\"animations\":[],\"canvasId\":\"canvas-main\",\"events\":{},\"groupStyle\":{},\"isLock\":false,\"isShow\":true,\"collapseName\":[\"position\",\"background\",\"style\",\"picture\"],\"linkage\":{\"duration\":0,\"data\":[{\"id\":\"\",\"label\":\"\",\"event\":\"\",\"style\":[{\"key\":\"\",\"value\":\"\"}]}]},\"component\":\"UserView\",\"name\":\"富文本\",\"label\":\"富文本\",\"propValue\":{\"textValue\":\"<p style=\\\"margin-top: 10px; color: #172b4d; font-family: -apple-system, 'system-ui', 'Segoe UI', Roboto, Oxygen, Ubuntu, 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif; font-size: 14px; line-height: 2; text-align: center;\\\"><strong><span style=\\\"font-family: STFangsong;\\\"><span style=\\\"font-size: 14px; color: #076655;\\\">2012 年至 2020 的 9 年间</span></span></strong></p>\\n<p style=\\\"margin-top: 10px; color: #172b4d; font-family: -apple-system, 'system-ui', 'Segoe UI', Roboto, Oxygen, Ubuntu, 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif; font-size: 14px; line-height: 2; text-align: center;\\\"><strong><span style=\\\"font-size: 20px; font-family: STFangsong;\\\"><span style=\\\"color: #000000;\\\"><span style=\\\"color: #e03e2d;\\\">工业用电依然占据大头</span></span></span></strong></p>\\n<p style=\\\"margin-top: 10px; color: #172b4d; font-family: -apple-system, 'system-ui', 'Segoe UI', Roboto, Oxygen, Ubuntu, 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif; font-size: 14px; line-height: 2; text-align: center;\\\"><strong><span style=\\\"font-family: STFangsong;\\\"><span style=\\\"text-align: justify; color: #076655;\\\">从电消费增长趋势中可以看出</span></span></strong></p>\\n<p style=\\\"margin-top: 10px; color: #172b4d; font-family: -apple-system, 'system-ui', 'Segoe UI', Roboto, Oxygen, Ubuntu, 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif; font-size: 14px; line-height: 2; text-align: center;\\\"><strong><span style=\\\"font-family: STFangsong;\\\"><span style=\\\"text-align: justify;\\\"><span style=\\\"color: #e03e2d;\\\">2014</span>&nbsp;<span style=\\\"color: #076655;\\\">年至</span>&nbsp;<span style=\\\"color: #e03e2d;\\\">2015</span>&nbsp;<span style=\\\"color: #076655;\\\">年</span></span></span></strong></p>\\n<p style=\\\"margin-top: 10px; color: #172b4d; font-family: -apple-system, 'system-ui', 'Segoe UI', Roboto, Oxygen, Ubuntu, 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif; font-size: 14px; line-height: 2; text-align: center;\\\"><strong><span style=\\\"font-family: STFangsong;\\\"><span style=\\\"text-align: justify;\\\"><span style=\\\"color: #076655;\\\">我国电力消费</span></span></span><span style=\\\"font-family: STFangsong;\\\"><span style=\\\"text-align: justify;\\\"><span style=\\\"color: #e03e2d; font-size: 20px;\\\">增长缓慢</span></span></span></strong></p>\\n<p style=\\\"margin-top: 10px; color: #172b4d; font-family: -apple-system, 'system-ui', 'Segoe UI', Roboto, Oxygen, Ubuntu, 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif; font-size: 14px; line-height: 2; text-align: center;\\\"><strong><span style=\\\"font-family: STFangsong;\\\"><span style=\\\"text-align: justify;\\\"><span style=\\\"color: #076655;\\\">尤其是</span>&nbsp;<span style=\\\"color: #e03e2d; font-size: 20px;\\\">2015</span>&nbsp;<span style=\\\"color: #076655;\\\">年</span></span></span></strong></p>\\n<p style=\\\"margin-top: 10px; color: #172b4d; font-family: -apple-system, 'system-ui', 'Segoe UI', Roboto, Oxygen, Ubuntu, 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif; font-size: 14px; line-height: 2; text-align: center;\\\"><strong><span style=\\\"font-family: STFangsong;\\\"><span style=\\\"text-align: justify;\\\"><span style=\\\"color: #076655;\\\">工业电能消费出现了</span></span></span><span style=\\\"font-family: STFangsong;\\\"><span style=\\\"text-align: justify;\\\"><span style=\\\"color: #e03e2d; font-size: 20px;\\\">负增长</span></span></span></strong></p>\\n<p style=\\\"margin-top: 10px; color: #172b4d; font-family: -apple-system, 'system-ui', 'Segoe UI', Roboto, Oxygen, Ubuntu, 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif; font-size: 14px; line-height: 2; text-align: center;\\\">&nbsp;</p>\\n<p style=\\\"margin-top: 10px; color: #172b4d; font-family: -apple-system, 'system-ui', 'Segoe UI', Roboto, Oxygen, Ubuntu, 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif; font-size: 14px; line-height: 2; text-align: center;\\\"><span style=\\\"color: #999999; font-family: AlibabaPuHuiTi, 'Helvetica Neue', Helvetica, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', Arial, FangSong, SimHei, STHeiti, STKaiti, STSong, 'STFangsong sans-serif'; font-size: 12px; letter-spacing: 1px; background-color: #efefef;\\\">在中国电力企业联合会发布的《2016年度全国电力供需形势分析预测报告》中可以发现：2015年，受宏观经济尤其是重化工业生产下滑、产业结构调整、工业转型升级以及气温等因素影响，全社会用电量增速回落，第二产业用电量40年来首次负增长。而固定资产投资特别是房地产投资增速持续放缓，导致黑色金属冶炼和建材行业用电均出现下滑，两行业用电下降是工业用电量下降、全社会用电量低速增长的主要原因。</span></p>\"},\"icon\":\"bar\",\"innerType\":\"rich-text\",\"editing\":false,\"canvasActive\":false,\"x\":1,\"y\":19,\"sizeX\":7,\"sizeY\":14,\"style\":{\"rotate\":0,\"opacity\":1,\"width\":290.8888888888889,\"height\":691.4444444444443,\"left\":0,\"top\":889},\"matrixStyle\":{},\"commonBackground\":{\"backgroundColorSelect\":true,\"backgroundImageEnable\":true,\"backgroundType\":\"outerImage\",\"innerImage\":\"board/board_9.svg\",\"outerImage\":\"/static-resource/7168071138071810048.png\",\"innerPadding\":12,\"borderRadius\":0,\"backgroundColor\":\"#1B635E0D\",\"innerImageColor\":\"rgba(16, 148, 229, 1)\"},\"state\":\"prepare\",\"render\":\"custom\",\"id\":\"